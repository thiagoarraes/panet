# .env.example
# Copie este arquivo para .env e preencha com os valores do seu projeto Supabase.
# NUNCA comite o arquivo .env no Git (já está no .gitignore).

# ─── Cliente (Vite) — expostas no bundle, use SEMPRE a chave anon/publishable ──
# Encontre em: Supabase → seu projeto → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Opcional (alias suportado): mesma chave publishable/anon
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# ─── Servidor (Vercel Functions /api/auth/*) — NUNCA expor no cliente ──────────
# Usadas pelas serverless functions de autenticação (cookies httpOnly) e pelos
# scripts de manutenção (cleanup/migração de Storage).
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Chave de service role (acesso total, ignora RLS) — só no servidor/scripts.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
